{
  "compileOnSave": false,
  "compilerOptions": {
    "declaration": true,
    "importHelpers": true,
    "strict": true,
    "lib": [
      "ESNext",
      "dom",
      "dom.iterable"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "sourceMap": true,
    "target": "esnext",
    "typeRoots": [
      "../node_modules/@types"
    ],
    "outDir": "dist",
    "noEmit": false,
    "skipLibCheck": true
  },
  "exclude": [
    "dist/**/*",
    "test/**/*"
  ]
}
